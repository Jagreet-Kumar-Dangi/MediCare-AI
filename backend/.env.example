APPLICATION_NAME=MediCare AI
APP_TITLE=MediCare AI API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://medicare_ai:replace-me@localhost:5432/medicare_ai
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
MEDICAL_RECORDS_STORAGE_DIR=storage/medical-records
MEDICAL_RECORDS_MAX_UPLOAD_SIZE_MB=10
DOCTOR_CREDENTIALS_STORAGE_DIR=storage/doctor-credentials
DOCTOR_CREDENTIALS_MAX_UPLOAD_SIZE_MB=10
REQUIRED_DOCTOR_CREDENTIAL_TYPES=["MEDICAL_REGISTRATION_CERTIFICATE","MEDICAL_DEGREE_CERTIFICATE"]
APPOINTMENT_TIMEZONE=UTC
PATIENT_APPOINTMENT_CANCELLATION_CUTOFF_HOURS=24
PATIENT_APPOINTMENT_RESCHEDULING_CUTOFF_HOURS=24
APPOINTMENT_REMINDER_24H_MINUTES=1440
APPOINTMENT_REMINDER_1H_MINUTES=60
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=21600
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=
